# Fails if any file under DIR mentions JUCE or a floating-point type (docs/02-spec.md C2).
file(GLOB_RECURSE files "${DIR}/*.h" "${DIR}/*.cpp")
set(bad "")
foreach(f IN LISTS files)
    file(STRINGS "${f}" lines REGEX "juce|JUCE|(^|[^A-Za-z_])(float|double|long double)([^A-Za-z_]|$)")
    if(lines)
        list(APPEND bad "${f}: ${lines}")
    endif()
endforeach()
if(bad)
    message(FATAL_ERROR "core/ must not use JUCE or floating point:\n${bad}")
endif()
list(LENGTH files n)
message(STATUS "core purity check: ${n} files clean")
